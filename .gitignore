# Qualquer `.env` vai fora, exceto o exemplo. O padrão original só pegava
# `.env` e `.env.local`, e deixava `.env.development` e `.env.production` com
# uma chave de pagamento real prontos para o commit.
.env
.env.*
!.env.example

# Stack local do Supabase. Aqui dentro moram a `sb_secret_` da stack e o
# segredo de assinatura do JWT do GoTrue: são credenciais de verdade, geradas
# na máquina, e nada disso vai para o repositório.
supabase/.temp
supabase/.branches
supabase/.env

