# Nome das variáveis, sem os valores. Copie para `.env` e preencha.
#
# As chaves `VITE_` são embutidas no bundle do navegador pelo Vite — é para
# isso que existem, e é por isso que elas são públicas por definição. Ainda
# assim, nenhuma delas vai para o repositório.

# Projeto do Supabase
SUPABASE_PROJECT_ID=
SUPABASE_PUBLABASE_KEY=
SUPABASE_URL=

# Mesmas três, com o prefixo que o navegador consome
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Domínio público do app. Sem esta, o padrão em `src/lib/env.ts` vale.
VITE_SITE_URL=

# Token do Graph API da Meta não fica aqui: é cifrado no Postgres e só sai
# pela interface do painel, nunca por variável de ambiente.
